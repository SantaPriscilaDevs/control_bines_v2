# Copia este archivo a .env (no se versiona). Expo lo lee al iniciar `expo start` o al compilar.

# development: se instala aparte como «Mobile App DEV» (paquete con sufijo .dev).
# production: el paquete definitivo.
APP_VARIANT=development

# API del ERP, terminando en /api/auth/. En el handheld va la IP del servidor, no localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.42/api/auth/
