<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- El SDK del lector de códigos lo exige (lee datos del equipo); sin él no abre. -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />

  <!-- Los servicios de escaneo del sistema (HY416 y HY830): si están, el código llega por broadcast. -->
  <queries>
    <package android:name="com.eastaeon.scandecoderservice" />
    <package android:name="com.barcode.scanner" />
  </queries>
</manifest>
